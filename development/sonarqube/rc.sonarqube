#!/bin/sh

PIDDIR="/var/run/sonarqube"
RUNAS="sonar"
SCRIPT="/sbin/sonar.sh"
# SonarQube needs Java >= 21: keep SONAR_JAVA_PATH if set, otherwise use
# OpenJDK21 (/usr/lib64/java) or the newest zulu-openjdk
if [ -z "${SONAR_JAVA_PATH}" ]; then
  for j in /usr/lib64/java/bin/java $(ls -d /usr/lib64/zulu-openjdk*/bin/java 2>/dev/null | sort -rV); do
    [ -x "$j" ] && { SONAR_JAVA_PATH="$j"; break; }
  done
fi
export SONAR_JAVA_PATH

case "$1" in

    'console')
        su ${RUNAS} -c "PIDDIR=${PIDDIR} ${SCRIPT} $*"
        ;;

    'start')
        su ${RUNAS} -c "PIDDIR=${PIDDIR} ${SCRIPT} $*"
        ;;

    'stop')
        su ${RUNAS} -c "PIDDIR=${PIDDIR} ${SCRIPT} $*"
        ;;

    'force-stop')
        su ${RUNAS} -c "PIDDIR=${PIDDIR} ${SCRIPT} $*"
        ;;

    'restart')
        su ${RUNAS} -c "PIDDIR=${PIDDIR} ${SCRIPT} $*"
        ;;

    'status')
        su ${RUNAS} -c "PIDDIR=${PIDDIR} ${SCRIPT} $*"
        ;;

    'dump')
        su ${RUNAS} -c "PIDDIR=${PIDDIR} ${SCRIPT} $*"
        ;;

    *)
        echo "Usage: $0 { console | start | stop | force-stop | restart | status | dump }"
        exit 1
        ;;
esac

exit 0
