From 2758cd04359e3dee8cdc9abea7263587a1ac720c Mon Sep 17 00:00:00 2001
From: sukanka <su975853527@gmail.com>
Date: Thu, 23 Jul 2026 23:30:08 +0800
Subject: [PATCH] Build geometry serializers as shared libs

Honor BUILD_SHARED_LIBS for schema-specific geometry serializers and select shared HDF5 libraries for shared package builds. Keep the serializer target list propagated to its parent scope.

Generated with the assistance of an AI coding tool.
---
 cmake/FindHDF5.cmake                            | 2 ++
 src/ifcgeom/Serialization/schema/CMakeLists.txt | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/cmake/FindHDF5.cmake b/cmake/FindHDF5.cmake
index 3230336a7d6..0be54d10e93 100644
--- a/cmake/FindHDF5.cmake
+++ b/cmake/FindHDF5.cmake
@@ -40,6 +40,8 @@ if(HDF5_LIBRARY_DIR)
         if(WIN32)
             set(zlib_post lib)
             set(lib_ext lib)
+        elseif(BUILD_SHARED_LIBS)
+            set(lib_ext so)
         else()
             set(lib_ext a)
         endif()
diff --git a/src/ifcgeom/Serialization/schema/CMakeLists.txt b/src/ifcgeom/Serialization/schema/CMakeLists.txt
index 583c177634a..7a60bf12439 100644
--- a/src/ifcgeom/Serialization/schema/CMakeLists.txt
+++ b/src/ifcgeom/Serialization/schema/CMakeLists.txt
@@ -1,5 +1,5 @@
 foreach(schema ${SCHEMA_VERSIONS})
-    add_library(geometry_serializer_ifc${schema} OBJECT Serialization.cpp)
+    add_library(geometry_serializer_ifc${schema} Serialization.cpp)
     target_link_libraries(geometry_serializer_ifc${schema} ${OpenCASCADE_LIBRARIES})
     set_target_properties(
         geometry_serializer_ifc${schema}
